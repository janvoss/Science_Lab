@article{ungureanu_uniformity_2013,
	title = {Uniformity Assumptions and the Musgrave Mäki-Hindriks Debate},
	volume = {6},
	issn = {18550541},
	url = {http://www.iiass.com/index.php?option=com_content&view=article&id=943},
	doi = {10.12959/issn.1855-0541.IIASS-2013-no2-art05},
	abstract = {In this paper I address the problem of the unrealisticness of assumptions in neoclassical economics2. Being accused of using highly unrealistic assumptions in its models, neoclassical economics replied through what later was called the F-twist. Shortly stated, it was claimed that descriptively unrealistic assumptions are ubiquitous in other sciences also, and that economics should be concerned with its predictions instead of its assumptions. The immediate implication of this statement was that all unrealistic assumptions are the same – they are harmlessly unrealistic. Philosophers of economics vivaciously debated this claim and argued that economics made use of several kinds of assumptions which ”had better be true”3. Building on this debate I introduce the notion of uniformity assumptions and I argue that in certain conditions they ”had better be true”.},
	number = {2},
	journaltitle = {Innovative Issues and Approaches in Social Sciences},
	shortjournal = {{IIASS}},
	author = {Ungureanu, Mihai},
	urldate = {2026-04-16},
